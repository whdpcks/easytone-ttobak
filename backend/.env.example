# 이 파일을 .env로 복사해서 값을 채우세요. .env는 깃에 올리지 않습니다.

# Upstage (C: 문서 읽기·LLM, D: AI 검색)
UPSTAGE_API_KEY=

# 팀 공통 SQLite 파일 (backend 폴더 기준)
TTOBAK_DB_PATH=data/ttobak.db

# 배포 시 프론트 주소. 쉼표로 여러 개. 비우면 전부 허용(개발용)
TTOBAK_CORS_ORIGINS=

# 시연용 사용자(김순자, 010-1234-5678)와 가족(딸 김미영) 자동 생성 여부
TTOBAK_SEED_DEMO=1

# '체험하기'(시연 계정 바로 로그인) 버튼 허용. 실제 배포에서는 0
TTOBAK_DEMO_LOGIN=1

# 문자 발송: demo = 실제로 보내지 않고 앱에 가짜 문자 알림으로 표시
TTOBAK_SMS_MODE=demo
